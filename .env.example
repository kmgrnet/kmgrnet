MYSQL_ROOT_PASSWORD=GuangRun_DB_Pass_2026
MYSQL_DATABASE=likeshop_db
REDIS_PASSWORD=GuangRun_Redis_Pass_2026

# nginx 宿主机端口映射，默认 80/443。如宿主机该端口已被其他服务占用（常见于本机
# 开发环境），可在本机 .env 中覆盖，例如 NGINX_HTTP_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 微信支付 v3 APIv3 密钥（商户平台 -> 账户设置 -> API安全 中设置的32位密钥）
WECHAT_API_V3_KEY=

# 微信支付平台证书公钥在容器内的路径，对应 ./wechat/certs 挂载目录
# 从 https://api.mch.weixin.qq.com/v3/certificates 下载后放入 wechat/certs/ 并在此填写容器内路径
WECHAT_PLATFORM_PUBLIC_KEY_PATH=/etc/wechat/certs/wechatpay_platform.pem
